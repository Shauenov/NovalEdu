# ─── App ─────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-at-least-32-chars
APP_HOST=https://educonductor.college.edu.kz

# ─── JWT ─────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ─── Database ────────────────────────────────────────────
POSTGRES_DB=educonductor
POSTGRES_USER=ec_user
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql+asyncpg://ec_user:change_this_password@postgres:5432/educonductor

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MinIO ───────────────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# ─── Email ───────────────────────────────────────────────
EMAIL_HOST=smtp.college.edu.kz
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=noreply@educonductor.college.edu.kz
EMAIL_HOST_PASSWORD=smtp_password
EMAIL_FROM_NAME=EduConductor

# ─── Timezone ────────────────────────────────────────────
TZ=Asia/Almaty

# ─── File Limits ─────────────────────────────────────────
MAX_DOCUMENT_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5

# ─── Conductor Account ───────────────────────────────────
CONDUCTOR_EMAIL=conductor@college.edu.kz
CONDUCTOR_INITIAL_PASSWORD=change_immediately
