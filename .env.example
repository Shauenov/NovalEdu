# ─── App ─────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-at-least-32-chars
APP_HOST=https://api.nobal.tech
# Public browser-facing frontend URL (used for CORS + links in emails).
FRONTEND_URL=https://nobal.tech

# ─── JWT ─────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ─── Database ────────────────────────────────────────────
POSTGRES_DB=nobal
POSTGRES_USER=ec_user
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql+asyncpg://ec_user:change_this_password@postgres:5432/nobal

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MinIO ───────────────────────────────────────────────
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
# Public (browser-facing) endpoint for file URLs / presigning.
# In production point this at the files subdomain served over HTTPS by nginx.
MINIO_PUBLIC_ENDPOINT=files.nobal.tech
MINIO_PUBLIC_USE_SSL=true

# ─── Email ───────────────────────────────────────────────
# NOTE: DigitalOcean blocks outbound SMTP ports 25/465/587. Use a relay that
# offers an alternate port (e.g. SMTP2GO on 2525). EMAIL_HOST_USER may be a
# relay username (not an email), so set EMAIL_FROM_ADDRESS for the "From".
EMAIL_HOST=mail.smtp2go.com
EMAIL_PORT=2525
EMAIL_USE_TLS=true
EMAIL_HOST_USER=smtp2go_username
EMAIL_HOST_PASSWORD=smtp2go_password
EMAIL_FROM_NAME=Nobal Education
EMAIL_FROM_ADDRESS=noreply@nobal.tech

# ─── Timezone ────────────────────────────────────────────
TZ=Asia/Almaty

# ─── File Limits ─────────────────────────────────────────
MAX_DOCUMENT_SIZE_MB=10
MAX_IMAGE_SIZE_MB=5

# ─── Adviser Account ─────────────────────────────────────
ADVISER_EMAIL=adviser@college.edu.kz
ADVISER_INITIAL_PASSWORD=change_immediately
